{
  "id": "pihole",
  "name": "Pi-hole DNS Controller & Telemetry Bridge",
  "version": "1.0.0",
  "description": "Bridges local Pi-hole DNS sinkhole metrics and controls to the MQTT cloud bus.",
  "author": "Antigravity Architect",
  "triggers": [
    "pi/commands/pihole/status",
    "pi/commands/pihole/enable",
    "pi/commands/pihole/disable",
    "pi/commands/pihole/update-gravity"
  ],
  "execution": {
    "type": "cli",
    "command": "python3 /opt/pi-plugins/pihole/main.py",
    "timeoutSeconds": 60,
    "idleRamMb": 0
  },
  "permissions": [
    "network:local",
    "exec:pihole"
  ]
}
