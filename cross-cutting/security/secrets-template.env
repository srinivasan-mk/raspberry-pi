# ==============================================================================
# Cross-Cutting Secrets Template for Raspberry Pi & Pi-hole Ecosystem
# Copy this file to /etc/raspberry-pi/.env and secure it:
#   sudo chown root:pi /etc/raspberry-pi/.env
#   sudo chmod 600 /etc/raspberry-pi/.env
# ==============================================================================

# --- MQTT Cloud Service Bus (HiveMQ / EMQX Cloud) ---
BROKER_HOST=xxxxxx.emqxsl.com
BROKER_PORT=8883
BROKER_USERNAME=pi_client
BROKER_PASSWORD=YourStrongPasswordHere
BROKER_USE_TLS=true
DEVICE_ID=raspberrypi-4b-home

# --- Pi-hole Administrative Credentials ---
PIHOLE_WEBPASSWORD=YourPiholeAdminPassword
PIHOLE_API_TOKEN=YourPiholeApiTokenIfV5

# --- Messaging Plugin Credentials ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
ANDROID_SMS_GATEWAY_URL=
ANDROID_SMS_API_KEY=

# --- Security & Network ---
LOCAL_SUBNET=192.168.1.0/24
DNS_FALLBACK_UPSTREAM=1.1.1.1
