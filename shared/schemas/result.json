{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginResultEnvelope",
  "type": "object",
  "required": ["messageId", "pluginId", "action", "status", "timestamp"],
  "properties": {
    "messageId": { "type": "string" },
    "correlationId": { "type": "string" },
    "pluginId": { "type": "string" },
    "action": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "TIMEOUT", "CANCELLED"]
    },
    "durationMs": { "type": "integer" },
    "data": { "type": "object" },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "timestamp": { "type": "integer" }
  }
}
