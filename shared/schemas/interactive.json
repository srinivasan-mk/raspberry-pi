{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InteractiveChallengeAndResponse",
  "definitions": {
    "InteractivePrompt": {
      "type": "object",
      "required": ["sessionId", "pluginId", "promptType", "message", "timeoutSeconds", "timestamp"],
      "properties": {
        "sessionId": { "type": "string" },
        "correlationId": { "type": "string" },
        "pluginId": { "type": "string" },
        "promptType": { "type": "string", "enum": ["OTP", "CONFIRMATION", "INPUT", "CAPTCHA"] },
        "message": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "default": 120 },
        "timestamp": { "type": "integer" }
      }
    },
    "InteractiveResponse": {
      "type": "object",
      "required": ["sessionId", "response", "timestamp"],
      "properties": {
        "sessionId": { "type": "string" },
        "correlationId": { "type": "string" },
        "response": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string" },
            "confirmed": { "type": "boolean" },
            "extra": { "type": "object" }
          }
        },
        "timestamp": { "type": "integer" }
      }
    }
  }
}
